GET {{host}}/db/pool-stats

### ===== 08 Security =====
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "admin@acme.com", "password": "password123", "role": "admin", "org": "acme" }
###
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "admin@acme.com", "password": "password123" }
###
@token = {{login.response.body.accessToken}}
@refresh = {{login.response.body.refreshToken}}
GET {{host}}/auth/me
Authorization: Bearer {{token}}
###
GET {{host}}/auth/admin-only
Authorization: Bearer {{token}}
###
GET {{host}}/auth/invoices/1
Authorization: Bearer {{token}}
###
### invoice 3 belongs to org "globex" -> 404
GET {{host}}/auth/invoices/3
Authorization: Bearer {{token}}
###
POST {{host}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refresh}}" }
###
### Hit this 7 times quickly to see 429
GET {{host}}/rate-limit/token-bucket
###
POST {{host}}/auth/login-limited
Content-Type: application/json

{ "email": "admin@acme.com", "password": "wrong" }

### ===== 09 Background jobs =====
# @name job
POST {{host}}/jobs/email
Content-Type: application/json

{ "to": "user@example.com", "failTimes": 2, "idempotencyKey": "order-1" }
###
GET {{host}}/jobs/{{job.response.body.jobId}}
###
GET {{host}}/jobs

